{
  "name": "@dt-ai-design/design-canvas-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "画布工具内核：pen 式 execute API（Insert/Copy/Update/Replace/Move/Delete/Get/SetVariables/FindEmptySpace）与事务沙箱",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@dt-ai-design/design-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
