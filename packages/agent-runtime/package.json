{
  "name": "@dt-ai-design/agent-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "运行时层：Agent 生命周期、消息队列、上下文管理",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@dt-ai-design/agent-protocol": "workspace:*",
    "@dt-ai-design/editor-core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
